# Host port exposed by docker compose
HOST_PORT=3000

# Link check cadence: 6h, 24h, 1d, or off
CHECK_INTERVAL=1d

# Set to 1 behind HTTPS so the session cookie is Secure
COOKIE_SECURE=0

# Administrator credentials (initialized on first launch)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Import demo sample data on first launch: 1 or 0
SEED_SAMPLE=0

# Favicon 防盗链：允许的 Referer 域名，逗号分隔；支持 *.example.com，* 允许任意来源
# 内网、回环及链路本地 IP 始终允许访问
FAVICON_ALLOWED_DOMAINS=nav.example.com,*.example.org
