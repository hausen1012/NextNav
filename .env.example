# Host port exposed by docker compose
HOST_PORT=3000

# Link check cadence: 6h, 24h, 1d, or off
CHECK_INTERVAL=1d

# Set to 1 behind HTTPS so the session cookie is Secure
COOKIE_SECURE=0

# Administrator credentials (initialized on first launch)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Import demo sample data on first launch: 1 or 0
SEED_SAMPLE=0
